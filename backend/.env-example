# ========================================
# 🗄️ CONFIGURAÇÃO DE BANCO DE DADOS
# ========================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SEUS DADOS

# Host do banco de dados
DB_HOST=localhost

# Porta padrão MySQL
DB_PORT=3306

# Nome do banco de dados
DB_NAME=unicake

# Usuário do banco de dados (recomenda-se criar um usuário específico)
DB_USER=root

# Senha do banco de dados
DB_PASSWORD=your_password_here

# Charset para suporte a emojis
DB_CHARSET=utf8mb4

# Connection pool
DB_CONNECTION_POOL_MIN=2
DB_CONNECTION_POOL_MAX=10

# Timeout em ms
DB_CONNECTION_TIMEOUT=10000

# ========================================
# 🔐 SEGURANÇA
# ========================================

# Chave secreta para JWT/Sessions
JWT_SECRET=sua_chave_super_secreta_muito_longa_e_aleatoria_aqui

# Tempo de expiração de token (em horas)
JWT_EXPIRY=24

# Salt para hash de senhas (bcrypt)
BCRYPT_ROUNDS=10

# ========================================
# 🌐 SERVIDOR/APLICAÇÃO
# ========================================

# Porta do servidor backend
APP_PORT=3000

# Ambiente (development, testing, production)
NODE_ENV=development

# URL base da aplicação
APP_URL=http://localhost:3000

# ========================================
# 📧 EMAIL (se implementar funcionalidade)
# ========================================

# Serviço de email (smtp, sendgrid, etc)
MAIL_SERVICE=smtp
MAIL_HOST=smtp.seu-provider.com
MAIL_PORT=587
MAIL_USER=seu_email@example.com
MAIL_PASSWORD=sua_senha_email
MAIL_FROM=noreply@unicake.com

# ========================================
# 💳 PAGAMENTO (se implementar)
# ========================================

# Chaves da API de pagamento (exemplo: Stripe)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_sua_chave_test
STRIPE_PUBLIC_KEY=pk_test_sua_chave_publica

# ========================================
# 📊 LOGGING
# ========================================

# Nível de log (error, warn, info, debug, trace)
LOG_LEVEL=info

# Diretório para logs
LOG_DIR=./logs

# ========================================
# 🛠️ DESENVOLVIMENTO
# ========================================

# Ativar CORS
CORS_ORIGIN=http://localhost:3000

# Ativar logs de debug SQL
DB_ENABLE_LOGS=true

# Rate limiting (requisições por minuto)
RATE_LIMIT=100

# ========================================
# INSTRUÇÕES DE SETUP
# ========================================
# 
# 1. Copie este arquivo:
#    cp backend/.env-example backend/.env
#
# 2. Preencha com seus dados reais:
#    - Altere DB_PASSWORD com sua senha MySQL
#    - Defina JWT_SECRET com algo aleatório e seguro
#    - Configure URLs e portas conforme sua infra
#
# 3. Nunca commite .env no repositório!
#    O arquivo .gitignore já deve ter:
#    *.env
#    .env.local
#
# 4. Para produção:
#    - Use senhas fortes
#    - Use HTTPS (não HTTP)
#    - Defina NODE_ENV=production
#    - Use banco de dados remoto/gerenciado
#    - Implemente rate limiting robusto
#
# ========================================
