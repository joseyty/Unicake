# ============================================
# 🔒 CONFIGURAÇÕES DE SEGURANÇA - .env
# ============================================
# NUNCA fazer commit deste arquivo com dados reais
# Duplicar como .env e preencher com valores seguros

# BANCO DE DADOS
DB_HOST=localhost
DB_USER=unicake_app
DB_PASSWORD=SenhaForteMuito@123#!
DB_NAME=unicake

# SEGURANÇA - JWT
JWT_SECRET=gere-uma-chave-muito-longa-e-aleatoria-com-openssl-rand-base64-32

# AMBIENTE
NODE_ENV=production
PORT=5550

# FRONTEND (CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# COMO GERAR JWT_SECRET SEGURO (Linux/Mac):
# openssl rand -base64 32
# 
# COMO NO WINDOWS (PowerShell):
# [Convert]::ToBase64String((New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes(32))
# ============================================
