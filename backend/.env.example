# Microsoft SQL Server
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=unicake_db
# Deixe DB_USER vazio para usar a autenticação do Windows
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
# "yes" aceita o certificado autoassinado do SQL Server local; use "no" em produção
DB_TRUST_SERVER_CERTIFICATE=yes

# API usada pelo site (python api.py)
API_PORT=5000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
